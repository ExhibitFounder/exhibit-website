---
interface Defaults { calls: number; missed: number; value: number; close: number; recover: number; season: number }
interface Props {
  /** Unit the inquiry count is entered in. Home services thinks in weeks, the others in months. */
  period?: 'week' | 'month';
  defaults: Defaults;
  callsLabel?: string;
  valueLabel?: string;
  closeLabel?: string;
}
const {
  period = 'month',
  defaults,
  callsLabel = `Inbound inquiries in a typical ${period}`,
  valueLabel = 'Value of one closed inquiry to you ($)',
  closeLabel = '% of answered inquiries that turn into business',
} = Astro.props;
const seasonMax = period === 'week' ? 52 : 12;
const seasonLabel = period === 'week' ? 'Weeks a year at this volume' : 'Months a year at this volume';
---

<div class="calc card" id="calc" data-season-max={seasonMax}>
  <div class="calc-head">
    <span class="eyebrow">Missed-call cost calculator</span>
    <h3>What is the unanswered phone costing you right now?</h3>
    <p class="small">Estimates only. The defaults reproduce the worked example on this page. Change them to your own numbers.</p>
  </div>
  <form class="calc-grid" onsubmit="return false">
    <div class="field">
      <label for="c-calls">{callsLabel}</label>
      <input id="c-calls" type="number" min="0" value={defaults.calls} inputmode="numeric" />
    </div>
    <div class="field">
      <label for="c-season">{seasonLabel}</label>
      <input id="c-season" type="number" min="1" max={seasonMax} value={defaults.season} inputmode="numeric" />
    </div>
    <div class="field">
      <label for="c-missed">% that go unanswered or wait more than 30 minutes</label>
      <input id="c-missed" type="number" min="0" max="100" value={defaults.missed} inputmode="numeric" />
    </div>
    <div class="field">
      <label for="c-close">{closeLabel}</label>
      <input id="c-close" type="number" min="0" max="100" value={defaults.close} inputmode="numeric" />
    </div>
    <div class="field">
      <label for="c-value">{valueLabel}</label>
      <input id="c-value" type="number" min="0" value={defaults.value} inputmode="numeric" />
    </div>
    <div class="field">
      <label for="c-recover">% of missed inquiries recovered<sup><a href="#fn-calc">*</a></sup></label>
      <input id="c-recover" type="number" min="0" max="100" value={defaults.recover} inputmode="numeric" />
    </div>
  </form>
  <div class="calc-out">
    <div class="stat"><b id="o-missed">0</b><span>missed inquiries a year</span></div>
    <div class="stat"><b id="o-leak">$0</b><span>annual revenue leaking</span></div>
    <div class="stat"><b id="o-recover">$0</b><span>recoverable a year at your recovery rate</span></div>
  </div>
  <p class="footnote" id="fn-calc">
    * The recovery rate is our planning assumption, not a benchmark. No independent study measures how many missed
    inquiries an automated system wins back, and the vendor figures we found were higher than we are willing to quote.
    Set it to whatever you believe. Individual results vary.
  </p>
  <div class="calc-cta">
    <a class="btn btn-primary" href="/book">See if you qualify</a>
    <span class="small">Managed Agent starts at $750/mo.</span>
  </div>
</div>

<script>
  const calc = document.getElementById('calc') as HTMLElement;
  const seasonMax = Number(calc.dataset.seasonMax) || 12;
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const num = (id: string, min: number, max = Infinity) => Math.min(max, Math.max(min, Number($(id).value) || 0));
  const pct = (id: string) => num(id, 0, 100) / 100;
  const fmt = (n: number) =>
    n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
  const run = () => {
    const calls = num('c-calls', 0);
    const season = num('c-season', 0, seasonMax);
    const value = num('c-value', 0);
    const missedPerYear = calls * season * pct('c-missed');
    const leak = missedPerYear * pct('c-close') * value;
    const recover = leak * pct('c-recover');
    $('o-missed').textContent = Math.round(missedPerYear).toLocaleString('en-US');
    $('o-leak').textContent = fmt(leak);
    $('o-recover').textContent = fmt(recover);
  };
  ['c-calls', 'c-season', 'c-missed', 'c-close', 'c-value', 'c-recover'].forEach((id) => $(id).addEventListener('input', run));
  run();
</script>

<style>
  .calc { padding: 32px; }
  .calc-head h3 { font-size: 1.5rem; }
  .calc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 20px; margin-top: 16px; }
  @media (max-width: 640px) { .calc-grid { grid-template-columns: 1fr; } }
  .calc-out {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
    padding: 20px; border-radius: 12px; background: var(--bg-2); margin: 8px 0 12px;
  }
  .calc-out .stat b { color: var(--amber); }
  @media (max-width: 640px) { .calc-out { grid-template-columns: 1fr; } }
  .calc-cta { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 16px; }
</style>
