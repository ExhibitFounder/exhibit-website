---
import Base from '../layouts/Base.astro';
import WaitlistPage from '../components/WaitlistPage.astro';
import CTA from '../components/CTA.astro';

const title = 'AI for Auto Repair Shops | Exhibit Automation';
const description =
  "Waitlist open. Calls answered, appointments booked, status updates sent, declined work followed up instead of forgotten. From $750/mo.";
---

<Base title={title} description={description} path="/auto-repair">
  <WaitlistPage
    eyebrow="Auto repair · 1 to 2 locations"
    h1="The phone rings while you are under a car."
    lede="Every call answered, appointments booked into your shop system, status updates sent before customers have to ask, and declined work followed up instead of forgotten."
    img="auto-repair"
    imgAlt="An empty two-bay auto repair shop at sunrise, a phone handset and clipboard on the front counter"
    imgCaption="The phone on the counter rang eleven times yesterday while both bays were busy."
    stats={[
      { big: '23%', label: 'of incoming calls to auto repair shops are missed during business hours<sup><a href="#fn1">1</a></sup>' },
      { big: '$650', label: 'average repair order value<sup><a href="#fn1">1</a></sup>' },
      { big: '~$4,200', label: 'estimated lifetime revenue behind a single lost customer, per AAA consumer research<sup><a href="#fn1">1</a></sup>' },
      { big: '82%', label: 'of consumers say they will call a competitor if a business does not answer<sup><a href="#fn2">2</a></sup>' },
    ]}
    handles={[
      '<b>Every inbound call answered</b>, including while you are in the bay or on another line',
      '<b>Appointments booked</b> into Shop-Ware, Tekmetric, Mitchell 1 or your calendar',
      '<b>Status updates</b> texted to customers at the points you choose, so the "is it ready" calls stop',
      '<b>Declined work follow-up</b>, the single biggest pile of money most shops leave sitting there',
      '<b>Service reminders</b> on mileage or date intervals',
      '<b>Parts and vendor confirmations</b>',
      '<b>Review requests</b> after a clean job',
      '<b>Morning digest</b> with the day\'s board and anything that needs you',
    ]}
    waits={[
      'Any estimate change or price exception',
      'Comebacks and warranty disputes',
      'Refunds and goodwill credits',
      'Diagnoses. The agent never guesses what is wrong with a car',
      'Anything a customer is angry about',
    ]}
    systems={['Shop-Ware', 'Tekmetric', 'Mitchell 1', 'AutoLeap', 'Protractor', 'QuickBooks', 'Google Workspace', 'RingCentral', 'OpenPhone', 'Twilio-based phones']}
    position="If your shop runs a full DMS with a dedicated service advisor, you likely need a platform rather than us. We are building for the one or two bay independent where the owner is also the service advisor and the phone is the bottleneck."
    footnotes={[
      { id: 'fn1', html: '1. <a href="https://agentzap.ai/blog/auto-repair-phone-statistics" rel="nofollow noopener">Auto Repair Shop Phone Statistics, 2026</a>, published by AgentZap, which sells AI phone answering. It attributes the 23% miss rate and $650 average repair order to the Automotive Service Association and the roughly $4,200 lifetime value to AAA consumer research. We have not seen the underlying studies.' },
      { id: 'fn2', html: '2. <a href="https://www.callrail.com/blog/missed-calls-cost-businesses-more-than-ever" rel="nofollow noopener">CallRail survey of 1,000 US consumers</a>, 2025, covering businesses in general. CallRail sells call-tracking software.' },
    ]}
  />
  <CTA title="Join the auto repair waitlist." body="Two minutes now, and you get the first slot when we open this industry. We will also tell you if a cheaper answering tool covers what you need in the meantime." />
</Base>
