---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, path = '/', schema } = Astro.props;
const site = 'https://joinexhibit.com';
const canonical = new URL(path, site).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Exhibit Automation',
  url: site,
  logo: `${site}/favicon.svg`,
  description:
    'Done-for-you operations automation for small service businesses. We connect to the software you already use, handle routine work 24/7, and send a morning digest of what needs a human.',
  email: 'hello@joinexhibit.com',
};

const schemas = [orgSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];

const industries = [
  { href: '/property-management', label: 'Property management' },
  { href: '/home-services', label: 'Home services' },
  { href: '/law-firms', label: 'Law firms' },
  { href: '/auto-repair', label: 'Auto repair' },
  { href: '/veterinary', label: 'Veterinary' },
];
const nav = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/compare', label: 'Compare' },
  { href: '/results', label: 'Results' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Exhibit Automation" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fbf7f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1526" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {/* Analytics: swap data-domain to the production domain at launch */}
    <script defer data-domain="joinexhibit.com" src="https://plausible.io/js/script.outbound-links.js"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand" aria-label="Exhibit Automation home">
          <svg width="28" height="28" viewBox="0 0 64 64" aria-hidden="true">
            <rect width="64" height="64" rx="14" fill="var(--ink)" />
            <circle cx="32" cy="34" r="13" fill="var(--amber)" />
            <rect x="10" y="40" width="44" height="10" fill="var(--ink)" />
            <rect x="10" y="44" width="44" height="3" fill="var(--bg)" />
          </svg>
          <span>Exhibit <b>Automation</b></span>
        </a>
        <input type="checkbox" id="nav-toggle" class="visually-hidden" />
        <label for="nav-toggle" class="nav-burger" aria-label="Toggle menu">
          <span></span><span></span><span></span>
        </label>
        <nav class="site-nav" aria-label="Primary">
          <div class="has-menu">
            <button
              type="button"
              class:list={['menu-top', { current: industries.some((i) => i.href === path) }]}
              aria-expanded="false"
              aria-haspopup="true"
            >
              Industries <span aria-hidden="true" class="caret">▾</span>
            </button>
            <div class="menu">
              {industries.map((i) => (
                <a href={i.href} aria-current={path === i.href ? 'page' : undefined}>{i.label}</a>
              ))}
            </div>
          </div>
          {nav.map((n) => (
            <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
          <a href="/book" class="btn btn-amber nav-cta">See if you qualify</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <script>
      const wrap = document.querySelector('.has-menu');
      const trigger = wrap?.querySelector('.menu-top') as HTMLButtonElement | null;
      if (wrap && trigger) {
        const setOpen = (open: boolean) => {
          wrap.classList.toggle('open', open);
          trigger.setAttribute('aria-expanded', String(open));
        };
        trigger.addEventListener('click', () => setOpen(!wrap.classList.contains('open')));
        document.addEventListener('click', (e) => {
          if (!wrap.contains(e.target as Node)) setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
      }
    </script>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="brand-foot"><b>Exhibit Automation</b><br /><span class="muted">Operations, handled.</span></p>
          <p class="small">
            We connect to the phone system, inbox and software you already use, handle the routine work 24/7, and send
            one morning digest of what needs a human.
          </p>
        </div>
        <div>
          <p class="foot-head">Industries</p>
          <a href="/property-management">Property management</a>
          <a href="/home-services">Home services</a>
          <a href="/law-firms">Law firms</a>
          <a href="/auto-repair">Auto repair</a>
          <a href="/veterinary">Veterinary</a>
        </div>
        <div>
          <p class="foot-head">Company</p>
          <a href="/how-it-works">How it works</a>
          <a href="/pricing">Pricing</a>
          <a href="/compare">Compare</a>
          <a href="/results">Results</a>
          <a href="/resources">Resources</a>
          <a href="/about">About</a>
          <a href="/book">Book an intro call</a>
          <a href="mailto:hello@joinexhibit.com">hello@joinexhibit.com</a>
        </div>
        <div>
          <p class="foot-head">Not for you if…</p>
          <ul class="small foot-list">
            <li>You just need someone to answer the phone.</li>
            <li>You're an enterprise with a procurement process.</li>
            <li>You handle patient health information.</li>
          </ul>
        </div>
      </div>
      <div class="wrap foot-bottom small">
        <span>© {new Date().getFullYear()} Exhibit Automation. Results shown are projected from industry benchmarks and are not guarantees.</span>
        <span><a href="/legal/privacy">Privacy</a> · <a href="/legal/terms">Terms</a></span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(150%) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner { display: flex; align-items: center; justify-content: space-between; height: 66px; gap: 16px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-size: 1.05rem; letter-spacing: -0.01em; }
  .brand b { font-weight: 700; }
  .site-nav { display: flex; align-items: center; gap: 26px; }
  .site-nav a { text-decoration: none; font-weight: 500; color: var(--ink-2); font-size: 0.97rem; }
  .site-nav a[aria-current='page'] { color: var(--ink); font-weight: 650; }
  .site-nav a:hover { color: var(--ink); }
  .nav-cta { padding: 10px 18px; font-size: 0.95rem; }
  .nav-cta:hover { color: #1b1408; }
  /* Padding creates a hover bridge so the pointer never leaves .has-menu on its way to .menu. */
  .has-menu { position: relative; padding-bottom: 16px; margin-bottom: -16px; }
  .menu-top {
    display: inline-flex; align-items: center; gap: 5px;
    font: inherit; font-size: 0.97rem; font-weight: 500; color: var(--ink-2);
    background: none; border: 0; padding: 0; cursor: pointer;
  }
  .menu-top:hover, .menu-top.current { color: var(--ink); }
  .menu-top.current { font-weight: 650; }
  .caret { font-size: 0.7em; color: var(--muted); }
  .menu {
    position: absolute; top: 100%; left: -14px; min-width: 214px;
    background: var(--card); border: 1px solid var(--line); border-radius: 12px;
    box-shadow: var(--shadow); padding: 8px; display: none; flex-direction: column; gap: 2px;
  }
  .has-menu:hover .menu, .has-menu:focus-within .menu, .has-menu.open .menu { display: flex; }
  .menu a { padding: 9px 12px; border-radius: 8px; font-size: 0.95rem; }
  .menu a:hover { background: var(--bg-2); }
  .nav-burger { display: none; flex-direction: column; gap: 5px; cursor: pointer; padding: 8px; }
  .nav-burger span { display: block; width: 22px; height: 2px; background: var(--ink); border-radius: 2px; }

  @media (max-width: 860px) {
    .nav-burger { display: flex; }
    .site-nav {
      display: none; position: absolute; top: 66px; left: 0; right: 0;
      flex-direction: column; align-items: flex-start; gap: 0;
      background: var(--bg); border-bottom: 1px solid var(--line); padding: 8px 20px 20px;
    }
    .site-nav a { padding: 12px 0; width: 100%; border-bottom: 1px solid var(--line); }
    .site-nav .nav-cta { border: 0; margin-top: 12px; width: auto; }
    #nav-toggle:checked ~ .site-nav { display: flex; }
    .has-menu { width: 100%; padding-bottom: 0; margin-bottom: 0; }
    .menu-top { display: none; }
    .menu { position: static; display: flex; border: 0; box-shadow: none; padding: 0; background: none; min-width: 0; }
    .menu a { padding: 12px 0; border-radius: 0; }
    .menu a:hover { background: none; }
  }

  .site-footer { border-top: 1px solid var(--line); background: var(--bg-2); padding: 56px 0 28px; margin-top: 40px; }
  .footer-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.3fr; gap: 32px; }
  .footer-grid a, .footer-grid span { display: block; text-decoration: none; margin-bottom: 8px; font-size: 0.95rem; color: var(--ink-2); }
  .footer-grid a:hover { color: var(--ink); }
  .foot-head { font-weight: 650; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 12px; }
  .brand-foot { margin-bottom: 12px; line-height: 1.35; }
  .foot-list { padding-left: 18px; margin: 0; }
  .foot-list li { margin-bottom: 6px; }
  .foot-bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line); }
  .foot-bottom a { color: inherit; }
  @media (max-width: 860px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 540px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
